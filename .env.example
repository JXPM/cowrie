# Enable Banking (https://enablebanking.com → Control Panel → API Applications)
ENABLE_APP_ID=
# Contenu du fichier .pem téléchargé à la création de l'app (les sauts de ligne peuvent être remplacés par \n)
ENABLE_PRIVATE_KEY=
# Mot de passe demandé par l'app avant tout appel bancaire (choisis-le)
APP_PASSWORD=
