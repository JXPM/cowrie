# Chaîne de connexion Neon Postgres (table `store`)
DATABASE_URL=
# Mode historique (un seul compte) : mot de passe demandé par l'app pour synchroniser le budget
APP_PASSWORD=
# Plusieurs comptes (remplace APP_PASSWORD si présente) : nom:motdepasse,nom2:motdepasse2 (12 caractères minimum)
APP_USERS=
# Propriétaire : garde les clés historiques budget-v2 et inbox-v1 (défaut johan)
APP_OWNER=johan
# Clé du résumé en lecture seule pour Johan OS (32 caractères minimum, sinon /api/summary renvoie 404)
SUMMARY_KEY=
